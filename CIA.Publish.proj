<Project DefaultTargets="Publish">

  <PropertyGroup>
    <_CiaRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</_CiaRepositoryRoot>
    <_CiaPublishDirectory>$(_CiaRepositoryRoot)artifacts\publish\win-x64\</_CiaPublishDirectory>
    <_CiaPublishProperties>Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=false;PublishTrimmed=false;DebugType=None;DebugSymbols=false;PublishDir=$(_CiaPublishDirectory)</_CiaPublishProperties>
    <_CiaAalLicenseFile Condition="'$(_CiaAalLicenseFile)' == ''">$(_CiaRepositoryRoot)LICENSE</_CiaAalLicenseFile>
    <_CiaAalSignedLicenseFile Condition="'$(_CiaAalSignedLicenseFile)' == ''">$(_CiaRepositoryRoot)LICENSE.asc</_CiaAalSignedLicenseFile>
    <_CiaAalPublicKeyFile Condition="'$(_CiaAalPublicKeyFile)' == ''">$(_CiaRepositoryRoot)docs\licensing\AAL-PUBLIC-KEY.asc</_CiaAalPublicKeyFile>
    <_CiaAalSignatureVerifier>$(_CiaRepositoryRoot)deployment\Verify-AalLicense.ps1</_CiaAalSignatureVerifier>
  </PropertyGroup>

  <ItemGroup>
    <_CiaApplicationProject Include="$(_CiaRepositoryRoot)src\CIA.Desktop\CIA.Desktop.csproj" />
    <_CiaApplicationProject Include="$(_CiaRepositoryRoot)src\CIA.ProcessingHost\CIA.ProcessingHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <_CiaRequiredLegalFile Include="$(_CiaAalLicenseFile)">
      <TargetPath>licenses\LICENSE</TargetPath>
    </_CiaRequiredLegalFile>
    <_CiaRequiredLegalFile Include="$(_CiaAalSignedLicenseFile)">
      <TargetPath>licenses\LICENSE.asc</TargetPath>
    </_CiaRequiredLegalFile>
    <_CiaRequiredLegalFile Include="$(_CiaRepositoryRoot)FORKING.md">
      <TargetPath>licenses\FORKING.md</TargetPath>
    </_CiaRequiredLegalFile>
    <_CiaRequiredLegalFile Include="$(_CiaRepositoryRoot)THIRD_PARTY_NOTICES.md">
      <TargetPath>licenses\THIRD_PARTY_NOTICES.md</TargetPath>
    </_CiaRequiredLegalFile>
    <_CiaRequiredLegalFile Include="$(_CiaRepositoryRoot)docs\licensing\README.md">
      <TargetPath>licenses\README.md</TargetPath>
    </_CiaRequiredLegalFile>
    <_CiaRequiredLegalFile Include="$(_CiaAalPublicKeyFile)">
      <TargetPath>licenses\AAL-PUBLIC-KEY.asc</TargetPath>
    </_CiaRequiredLegalFile>
    <_CiaRequiredLegalFile Include="$(_CiaRepositoryRoot)docs\licensing\third-party\*.*">
      <TargetPath>licenses\third-party\%(Filename)%(Extension)</TargetPath>
    </_CiaRequiredLegalFile>
  </ItemGroup>

  <Target Name="_ValidatePublicationLicensing">
    <Error
      Condition="!Exists('%(_CiaRequiredLegalFile.Identity)')"
      Text="Required publication license artifact is missing: %(_CiaRequiredLegalFile.Identity). The original author must provide LICENSE.asc and docs\licensing\AAL-PUBLIC-KEY.asc; do not publish or build the installer without them." />
    <Error
      Condition="!Exists('$(_CiaAalSignatureVerifier)')"
      Text="The AAL license signature verifier is missing: $(_CiaAalSignatureVerifier)." />
    <Exec
      Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(_CiaAalSignatureVerifier)&quot; -LicensePath &quot;$(_CiaAalLicenseFile)&quot; -SignedLicensePath &quot;$(_CiaAalSignedLicenseFile)&quot; -PublicKeyPath &quot;$(_CiaAalPublicKeyFile)&quot;" />
  </Target>

  <Target Name="_PreparePublishDirectory">
    <RemoveDir Directories="$(_CiaPublishDirectory)" />
    <MakeDir Directories="$(_CiaPublishDirectory)" />
  </Target>

  <Target Name="_RestoreApplications">
    <MSBuild
      Projects="@(_CiaApplicationProject)"
      Targets="Restore"
      BuildInParallel="false"
      Properties="RuntimeIdentifier=win-x64;SelfContained=true" />
  </Target>

  <Target Name="Publish" DependsOnTargets="_ValidatePublicationLicensing;_PreparePublishDirectory;_RestoreApplications">
    <MSBuild
      Projects="@(_CiaApplicationProject)"
      Targets="Publish"
      BuildInParallel="false"
      Properties="$(_CiaPublishProperties)" />

    <Error
      Condition="!Exists('$(_CiaPublishDirectory)CIA.exe')"
      Text="The CIA desktop executable is missing from the publication." />
    <Error
      Condition="!Exists('$(_CiaPublishDirectory)CIA.ProcessingHost.exe')"
      Text="The CIA Processing Host executable is missing from the publication." />
    <Error
      Condition="!Exists('$(_CiaPublishDirectory)CIA.dll') Or !Exists('$(_CiaPublishDirectory)CIA.ProcessingHost.dll') Or !Exists('$(_CiaPublishDirectory)CIA.Contracts.dll') Or !Exists('$(_CiaPublishDirectory)CIA.Core.dll')"
      Text="Required CIA application libraries are missing from the publication." />
    <Error
      Condition="!Exists('$(_CiaPublishDirectory)coreclr.dll') Or !Exists('$(_CiaPublishDirectory)hostfxr.dll') Or !Exists('$(_CiaPublishDirectory)hostpolicy.dll')"
      Text="The bundled .NET runtime is missing from the publication." />

    <ItemGroup>
      <_CiaUnexpectedTestAssembly Include="$(_CiaPublishDirectory)*.Tests.dll" />
    </ItemGroup>
    <Error
      Condition="'@(_CiaUnexpectedTestAssembly)' != ''"
      Text="Test assemblies must not be included in the CIA publication." />

    <MakeDir Directories="$(_CiaPublishDirectory)licenses\third-party" />
    <Copy
      SourceFiles="@(_CiaRequiredLegalFile)"
      DestinationFiles="@(_CiaRequiredLegalFile->'$(_CiaPublishDirectory)%(TargetPath)')"
      SkipUnchangedFiles="true" />

    <Error
      Condition="!Exists('$(_CiaPublishDirectory)licenses\LICENSE.asc') Or !Exists('$(_CiaPublishDirectory)licenses\AAL-PUBLIC-KEY.asc') Or !Exists('$(_CiaPublishDirectory)licenses\THIRD_PARTY_NOTICES.md')"
      Text="The publication is missing signed AAL or third-party notice artifacts." />

    <Message
      Importance="high"
      Text="Published CIA self-contained win-x64 multi-file runtime to $(_CiaPublishDirectory)" />
  </Target>

</Project>
