{
  "meta": {
    "name": "CIA Settings UI Preview",
    "version": "0.3",
    "status": "Reworked combined Settings workspace after full feature/ownership review",
    "basedOn": "v0.2 visual direction"
  },
  "implementationStatus": {
    "alreadyImplementedBackend": [
      "Structured processing-history and diagnostic records (SPR-99)",
      "Shared operation outcomes / partial completion semantics (SPR-102)",
      "Cooperative cancellation history support (SPR-101)",
      "Per-user writable-data path model for Settings, Profiles, Working, Database, Logs and Temp (SPR-109)"
    ],
    "implementedOperationalUiElsewhere": [
      "Load source/folder/archive options and source management",
      "Discovery run/selection/overrides/current-stale signaling",
      "Database UI reference and presentation/export configuration shell"
    ],
    "plannedForLaterImplementationButRequiredInThisDesign": [
      "Processing history / recorded-issues review UI (SPR-98)",
      "Working state persistence / restore / delete (SPR-93/94)",
      "Unavailable-path relink/remove workflow (SPR-95)",
      "Persistent application settings UI/service (SPR-96)",
      "Safe Reset to Defaults (SPR-97)",
      "Safe temporary/session cleanup (SPR-105/106)"
    ]
  },
  "shell": {
    "topLevelTabs": [
      "Load",
      "Discovery",
      "Database",
      "Settings"
    ],
    "activeTab": "Settings",
    "normalWindow": {
      "width": 1400,
      "height": 760
    },
    "minimumWindow": {
      "width": 1000,
      "height": 520
    },
    "responsiveBreakpointPx": 1180,
    "pageLevelVerticalScroll": false,
    "sameBehaviorAs": [
      "Load",
      "Discovery",
      "Database"
    ]
  },
  "layout": {
    "desktop": {
      "LogAndDiagnostics": "50%",
      "Settings": "50%",
      "gapPx": 8
    },
    "leftHalf": {
      "unifiedLogViewer": "2/3 height",
      "selectedEntryAndViewerControls": "1/3 height"
    },
    "rightHalf": {
      "settingsAndUtilities": "about 64%",
      "alwaysVisibleAboutHelp": "about 36%"
    },
    "responsive": {
      "below1180": "Within the single top-level Settings workspace, show Log & Diagnostics / Settings internal switch.",
      "aboutHelp": "Remains permanently visible whenever the Settings internal view is active."
    }
  },
  "logDiagnostics": {
    "singleUnifiedViewer": true,
    "entryTypes": [
      "Activity",
      "Issue",
      "Raw Log"
    ],
    "meaning": {
      "Activity": "Structured processing/operation history including successful processed items and generated-file records.",
      "Issue": "Structured warning/error/cancel/interruption diagnostic records.",
      "Raw Log": "Individual technical Desktop or Processing Host log entries, merged into the same viewer rather than a separate mechanic."
    },
    "tableColumns": [
      "Time",
      "Type",
      "Severity",
      "Area",
      "Outcome",
      "Stage / Category",
      "Stream",
      "Item / Source",
      "Message"
    ],
    "filters": [
      "Search",
      "Entry Type",
      "Severity",
      "Area / Operation",
      "Outcome",
      "Stream"
    ],
    "viewerControls": [
      "Auto-follow newest",
      "Wrap long messages",
      "Compact rows",
      "Open Logs Folder",
      "Export visible log"
    ],
    "selectedEntry": [
      "Operation / Diagnostic ID where available",
      "Type",
      "Severity",
      "Area / Operation",
      "Outcome",
      "Stage / Category",
      "Stream",
      "Item / Source",
      "User-facing summary",
      "Technical detail"
    ]
  },
  "settingsPersistence": {
    "automatic": true,
    "saveButton": false,
    "survivesRestart": true,
    "transientInteractionStateExcluded": true
  },
  "settings": {
    "General": [
      {
        "name": "Maximum archive nesting depth",
        "default": 3,
        "type": "number",
        "note": "Global persistent limit; recursive traversal and archive-retention controls stay in Load."
