<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="CiaBackgroundBrush" Color="#FFF7F8FC" />
    <SolidColorBrush x:Key="CiaPanelBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CiaPanelAlternateBrush" Color="#FFFAFBFD" />
    <SolidColorBrush x:Key="CiaTextPrimaryBrush" Color="#FF1F2430" />
    <SolidColorBrush x:Key="CiaTextSecondaryBrush" Color="#FF667085" />
    <SolidColorBrush x:Key="CiaTextMutedBrush" Color="#FF8A94A6" />
    <SolidColorBrush x:Key="CiaAccentBrush" Color="#FF6E6BFF" />
    <SolidColorBrush x:Key="CiaAccentAlternateBrush" Color="#FF4E8CFF" />
    <SolidColorBrush x:Key="CiaAccentSoftBrush" Color="#FFEFEFFF" />
    <SolidColorBrush x:Key="CiaAccentHoverBrush" Color="#FF5B52F5" />
    <SolidColorBrush x:Key="CiaBorderBrush" Color="#FFDDE2EA" />
    <SolidColorBrush x:Key="CiaBorderStrongBrush" Color="#FFCBD2DD" />
    <SolidColorBrush x:Key="CiaSuccessBrush" Color="#FF2F8A59" />
    <SolidColorBrush x:Key="CiaWarningBrush" Color="#FFA66A00" />
    <SolidColorBrush x:Key="CiaWarningSoftBrush" Color="#FFFFF4DD" />
    <SolidColorBrush x:Key="CiaDangerBrush" Color="#FFB54747" />
    <SolidColorBrush x:Key="CiaModalOverlayBrush" Color="#381F2430" />
    <SolidColorBrush x:Key="CiaDisabledBackgroundBrush" Color="#FFF0F2F5" />
    <SolidColorBrush x:Key="CiaDisabledTextBrush" Color="#FF9AA3B2" />
    <SolidColorBrush x:Key="CiaSelectedRowBrush" Color="#FFF1F0FF" />
    <SolidColorBrush x:Key="CiaHoverBrush" Color="#FFF8F9FC" />
    <SolidColorBrush x:Key="CiaDividerBrush" Color="#FFEEF1F5" />
    <SolidColorBrush x:Key="CiaProgressTrackBrush" Color="#FFECEFF4" />
    <SolidColorBrush x:Key="CiaNoteBackgroundBrush" Color="#FFF6F7FA" />
    <SolidColorBrush x:Key="CiaDropOverlayBrush" Color="#F0FCFCFE" />

    <LinearGradientBrush x:Key="CiaLogoBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF4E8CFF" />
        <GradientStop Offset="1" Color="#FF6E6BFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CiaAccentGradientBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF756FFF" />
        <GradientStop Offset="1" Color="#FF5E68F4" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CiaSelectedTabBrush"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFF2F1FF" />
        <GradientStop Offset="1" Color="#FFFCFCFF" />
    </LinearGradientBrush>

    <FontFamily x:Key="CiaFontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="CiaBodyFontSize">12.5</sys:Double>
    <sys:Double x:Key="CiaControlHeight">29</sys:Double>
    <Thickness x:Key="CiaWorkspaceMargin">8</Thickness>
    <Thickness x:Key="CiaTopBarPadding">15,0</Thickness>
    <Thickness x:Key="CiaNavigationBarPadding">10,0</Thickness>
    <Thickness x:Key="CiaStatusBarPadding">10,0</Thickness>
    <Thickness x:Key="CiaPanelHeaderPadding">9,7</Thickness>
    <Thickness x:Key="CiaButtonPadding">10,0</Thickness>
    <CornerRadius x:Key="CiaPanelCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="CiaControlCornerRadius">7</CornerRadius>
    <Visibility x:Key="CiaNavigationSubtitleVisibility">Visible</Visibility>

    <Style x:Key="CiaPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CiaPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CiaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CiaPanelCornerRadius}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="2"
                                  Direction="270"
                                  Opacity="0.05"
                                  ShadowDepth="1"
                                  Color="#FF101828" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CiaPanelHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource CiaPanelHeaderPadding}" />
        <Setter Property="BorderBrush" Value="{StaticResource CiaBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="CiaDividerStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource CiaDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <ControlTemplate x:Key="CiaButtonTemplate" TargetType="Button">
        <Border x:Name="ButtonBorder"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource CiaControlCornerRadius}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder"
                        Property="Background"
                        Value="{StaticResource CiaHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder"
                        Property="Background"
                        Value="{StaticResource CiaDisabledBackgroundBrush}" />
                <Setter TargetName="ButtonBorder"
                        Property="BorderBrush"
                        Value="{StaticResource CiaBorderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource CiaDisabledTextBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="CiaPrimaryButtonTemplate" TargetType="Button">
        <Border x:Name="ButtonBorder"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource CiaControlCornerRadius}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder"
                        Property="Background"
                        Value="{StaticResource CiaAccentHoverBrush}" />
                <Setter TargetName="ButtonBorder"
                        Property="BorderBrush"
                        Value="{StaticResource CiaAccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder"
                        Property="Background"
                        Value="{StaticResource CiaDisabledBackgroundBrush}" />
                <Setter TargetName="ButtonBorder"
                        Property="BorderBrush"
                        Value="{StaticResource CiaBorderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource CiaDisabledTextBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="CiaButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource CiaControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource CiaButtonPadding}" />
        <Setter Property="Background" Value="{StaticResource CiaPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CiaBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource CiaTextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template" Value="{StaticResource CiaButtonTemplate}" />
    </Style>

    <Style x:Key="CiaPrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource CiaButtonStyle}">
        <Setter Property="Background" Value="{StaticResource CiaAccentGradientBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CiaAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CiaPanelBrush}" />
        <Setter Property="Template" Value="{StaticResource CiaPrimaryButtonTemplate}" />
    </Style>

    <Style x:Key="CiaGhostButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource CiaButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource CiaTextSecondaryBrush}" />
    </Style>

    <Style x:Key="CiaDangerButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource CiaButtonStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource CiaDangerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CiaDangerBrush}" />
    </Style>

    <Style x:Key="CiaTextInputStyle" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource CiaControlHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource CiaPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CiaBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource CiaTextPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource CiaDisabledBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CiaBorderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource CiaDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CiaPanelTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource CiaTextPrimaryBrush}" />
    </Style>

    <Style x:Key="CiaSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.8" />
        <Setter Property="Foreground" Value="{StaticResource CiaTextSecondaryBrush}" />
    </Style>

    <Style x:Key="CiaEmptyStateTitleTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CiaTextPrimaryBrush}" />
    </Style>

    <Style x:Key="CiaWorkspacePlaceholderTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource CiaEmptyStateTitleTextStyle}">
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="CiaStatusLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.8" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource CiaTextPrimaryBrush}" />
    </Style>

    <Style x:Key="CiaSourceHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="10.8" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource CiaTextSecondaryBrush}" />
    </Style>

    <Style x:Key="CiaShellBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CiaPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CiaBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="CiaTopBarStyle"
           TargetType="Border"
           BasedOn="{StaticResource CiaShellBarStyle}">
        <Setter Property="Padding" Value="{StaticResource CiaTopBarPadding}" />
    </Style>

    <Style x:Key="CiaNavigationBarStyle"
           TargetType="Border"
           BasedOn="{StaticResource CiaShellBarStyle}">
        <Setter Property="Padding" Value="{StaticResource CiaNavigationBarPadding}" />
    </Style>

    <Style x:Key="CiaStatusBarStyle"
           TargetType="Border"
           BasedOn="{StaticResource CiaShellBarStyle}">
        <Setter Property="Padding" Value="{StaticResource CiaStatusBarPadding}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style x:Key="CiaWorkspaceTabsStyle" TargetType="ListBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CiaWorkspaceTabItemStyle" TargetType="ListBoxItem">
        <Setter Property="Height" Value="60" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Foreground" Value="{StaticResource CiaTextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="TabBackground"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="9,9,0,0">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center" />
                            <Border x:Name="SelectedLine"
                                    Height="3"
                                    Margin="7,0"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource CiaAccentBrush}"
                                    CornerRadius="3"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBackground"
                                    Property="Background"
                                    Value="{StaticResource CiaHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource CiaTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBackground"
                                    Property="Background"
                                    Value="{StaticResource CiaSelectedTabBrush}" />
                            <Setter TargetName="SelectedLine"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource CiaAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="CiaWorkspaceTabTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IconBackground"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    CornerRadius="9">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                           Text="{Binding IconGlyph}" />
            </Border>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock FontSize="13.5"
                           FontWeight="Bold"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                           Text="{Binding Title}" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="10.2"
                           Foreground="{StaticResource CiaTextSecondaryBrush}"
                           Text="{Binding Description}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{DynamicResource CiaNavigationSubtitleVisibility}" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                         Value="True">
                <Setter TargetName="IconBackground"
                        Property="Background"
                        Value="{StaticResource CiaAccentSoftBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="CiaNeutralStateBadgeStyle" TargetType="Border">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource CiaDividerBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
</ResourceDictionary>
