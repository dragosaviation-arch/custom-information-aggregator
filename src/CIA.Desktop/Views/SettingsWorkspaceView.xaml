<UserControl x:Class="CIA.Desktop.Views.SettingsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="SettingsRoot"
             Loaded="OnViewLoaded"
             SizeChanged="OnViewSizeChanged"
             AutomationProperties.Name="Settings workspace">
    <UserControl.Resources>
        <Style x:Key="SettingsComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="{StaticResource CiaPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CiaBorderStrongBrush}" />
            <Setter Property="Foreground" Value="{StaticResource CiaTextPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Background" Value="{StaticResource CiaPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CiaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SettingsCompactButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CiaButtonStyle}">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style x:Key="SettingsLogListStyle" TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource CiaPanelBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>
        <Style x:Key="SettingsLogRowStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CompactRows, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="True">
                    <Setter Property="MinHeight" Value="24" />
                    <Setter Property="Padding" Value="1" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource CiaSelectedRowBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsDetailKeyStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource CiaSecondaryTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsDetailValueStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource CiaTextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SettingsHelpButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CiaGhostButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{StaticResource CiaDividerBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource CiaWorkspaceMargin}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="InternalSwitchRow" Height="0" />
            <RowDefinition x:Name="InternalSwitchGapRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="InternalSwitch"
                BorderBrush="{StaticResource CiaBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{StaticResource CiaPanelBrush}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="LogViewButton"
                        Click="OnLogViewClick"
                        Content="Log &amp; Diagnostics"
                        Style="{StaticResource CiaGhostButtonStyle}" />
                <Button x:Name="SettingsViewButton"
                        Grid.Column="1"
                        Click="OnSettingsViewClick"
                        Content="Settings"
                        Style="{StaticResource CiaGhostButtonStyle}" />
            </Grid>
        </Border>

        <Grid x:Name="SettingsLayout" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LogColumn" Width="*" />
                <ColumnDefinition x:Name="SettingsGapColumn" Width="8" />
                <ColumnDefinition x:Name="SettingsColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="LogDiagnosticsSide" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CiaPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="27" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CiaPanelHeaderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource CiaPanelTitleTextStyle}"
                                           Text="LOG &amp; DIAGNOSTICS" />
                                <Border Grid.Column="1"
                                        Height="20"
                                        Margin="7,0,0,0"
                                        Padding="7,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource CiaAccentSoftBrush}"
                                        CornerRadius="10">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="9.7"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CiaAccentBrush}"
                                               Text="Retained" />
                                </Border>
                                <TextBlock Grid.Column="2"
                                           Margin="8,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="Activity and issues in one viewer" />
                                <Button Grid.Column="3"
                                        AutomationProperties.Name="Refresh log and diagnostics"
                                        Command="{Binding RefreshCommand}"
                                        Content="Refresh"
                                        Style="{StaticResource SettingsCompactButtonStyle}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Margin="0,0,5,0"
                                     AutomationProperties.Name="Search retained entries"
                                     Style="{StaticResource CiaTextInputStyle}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Column="1"
                                      Margin="0,0,5,0"
                                      AutomationProperties.Name="Entry type filter"
                                      ItemsSource="{Binding EntryTypeOptions}"
                                      SelectedItem="{Binding SelectedEntryType, Mode=TwoWay}"
                                      Style="{StaticResource SettingsComboStyle}" />
                            <ComboBox Grid.Column="2"
                                      Margin="0,0,5,0"
                                      AutomationProperties.Name="Severity filter"
                                      ItemsSource="{Binding SeverityOptions}"
                                      SelectedItem="{Binding SelectedSeverity, Mode=TwoWay}"
                                      Style="{StaticResource SettingsComboStyle}" />
                            <ComboBox Grid.Column="3"
                                      Margin="0,0,5,0"
                                      AutomationProperties.Name="Area or operation filter"
                                      ItemsSource="{Binding AreaOptions}"
                                      SelectedItem="{Binding SelectedArea, Mode=TwoWay}"
                                      Style="{StaticResource SettingsComboStyle}" />
                            <ComboBox Grid.Column="4"
                                      Margin="0,0,5,0"
                                      AutomationProperties.Name="Outcome filter"
                                      ItemsSource="{Binding OutcomeOptions}"
                                      SelectedItem="{Binding SelectedOutcome, Mode=TwoWay}"
                                      Style="{StaticResource SettingsComboStyle}" />
                            <ComboBox Grid.Column="5"
                                      AutomationProperties.Name="Stream filter"
                                      ItemsSource="{Binding StreamOptions}"
                                      SelectedItem="{Binding SelectedStream, Mode=TwoWay}"
                                      Style="{StaticResource SettingsComboStyle}" />
                        </Grid>

                        <Border Grid.Row="2"
                                Padding="8,5"
                                Background="{StaticResource CiaWarningSoftBrush}"
                                BorderBrush="{StaticResource CiaWarningBrush}"
                                BorderThickness="0,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasReadProblem}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{StaticResource CiaWarningBrush}"
                                       Text="{Binding ReadProblem}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid Grid.Row="3">
                            <ListView x:Name="LogEntriesList"
                                      AutomationProperties.Name="Retained log and diagnostic entries"
                                      ItemContainerStyle="{StaticResource SettingsLogRowStyle}"
                                      ItemsSource="{Binding VisibleEntries}"
                                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                      Style="{StaticResource SettingsLogListStyle}">
                                <ListView.View>
                                    <GridView AllowsColumnReorder="False">
                                        <GridViewColumn Width="110"
                                                        DisplayMemberBinding="{Binding RecordedAtLocal, StringFormat={}{0:G}}"
                                                        Header="Time" />
                                        <GridViewColumn Width="64"
                                                        DisplayMemberBinding="{Binding EntryType}"
                                                        Header="Type" />
                                        <GridViewColumn Width="64"
                                                        DisplayMemberBinding="{Binding Severity}"
                                                        Header="Severity" />
                                        <GridViewColumn Width="105"
                                                        DisplayMemberBinding="{Binding Area}"
                                                        Header="Area" />
                                        <GridViewColumn Width="135"
                                                        DisplayMemberBinding="{Binding Outcome}"
                                                        Header="Outcome" />
                                        <GridViewColumn Width="125"
                                                        DisplayMemberBinding="{Binding Stage}"
                                                        Header="Stage / Category" />
                                        <GridViewColumn Width="75"
                                                        DisplayMemberBinding="{Binding Stream}"
                                                        Header="Stream" />
                                        <GridViewColumn Width="150"
                                                        DisplayMemberBinding="{Binding ItemOrSource}"
                                                        Header="Item / Source" />
                                        <GridViewColumn Width="270" Header="Message">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock MaxWidth="260"
                                                               Text="{Binding Message}"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextWrapping" Value="NoWrap" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.WrapLongMessages, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                 Value="True">
                                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                                        <Setter Property="TextTrimming" Value="None" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Margin="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding EmptyEntriesMessage}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CiaSecondaryTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVisibleEntries}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Border Grid.Row="4"
                                Padding="8,0"
                                BorderBrush="{StaticResource CiaBorderBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="{Binding VisibleEntryCountText}" />
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="Latest first" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CiaPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CiaPanelHeaderStyle}">
                            <Grid>
                                <TextBlock Style="{StaticResource CiaPanelTitleTextStyle}"
                                           Text="SELECTED ENTRY &amp; VIEWER CONTROLS" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="One detail surface for retained entry types" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="8,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.55*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="0.75*" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource SettingsDetailKeyStyle}" Text="ID" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SettingsDetailValueStyle}" Text="{Binding SelectedEntry.PrimaryId}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource SettingsDetailKeyStyle}" Text="Type" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource SettingsDetailValueStyle}" Text="{Binding SelectedEntry.EntryType}" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsDetailKeyStyle}" Text="Area" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsDetailValueStyle}" Text="{Binding SelectedEntry.Area}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsDetailKeyStyle}" Text="Outcome" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource SettingsDetailValueStyle}" Text="{Binding SelectedEntry.Outcome}" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource SettingsDetailKeyStyle}" Text="Stage" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingsDetailValueStyle}" Text="{Binding SelectedEntry.Stage}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingsDetailKeyStyle}" Text="Stream" />
                                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource SettingsDetailValueStyle}" Text="{Binding SelectedEntry.Stream}" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource SettingsDetailKeyStyle}" Text="Item" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource SettingsDetailValueStyle}" Text="{Binding SelectedEntry.ItemOrSource}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource SettingsDetailKeyStyle}" Text="Severity" />
                                        <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource SettingsDetailValueStyle}" Text="{Binding SelectedEntry.Severity}" />
                                    </Grid>

                                    <Border Margin="0,6,0,0"
                                            Padding="6,5"
                                            Background="{StaticResource CiaPanelAlternateBrush}"
                                            BorderBrush="{StaticResource CiaDividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource CiaTextSecondaryBrush}"
                                                       Text="{Binding SelectedEntry.Message}"
                                                       TextWrapping="Wrap" />
                                            <Expander Margin="0,4,0,0"
                                                      Header="Technical details">
                                                <StackPanel Margin="0,4,0,0">
                                                    <TextBlock x:Name="SelectedFailureCode"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               Foreground="{StaticResource CiaTextMutedBrush}"
                                                               Text="{Binding SelectedEntry.FailureCodeDisplay}"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedEntry.FailureCode}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock FontFamily="Consolas"
                                                               FontSize="10"
                                                               Foreground="{StaticResource CiaTextMutedBrush}"
                                                               Text="{Binding SelectedEntry.TechnicalDetail}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               FontFamily="Consolas"
                                                               FontSize="9.8"
                                                               Foreground="{StaticResource CiaTextMutedBrush}"
                                                               Text="{Binding SelectedEntry.OperationId, StringFormat=Operation {0}}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedEntry.IsActivity}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="9.8" FontWeight="Bold" Text="Successful" />
                                            <ItemsControl ItemsSource="{Binding SelectedEntry.Attempt.SuccessfulItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="9.6" Text="{Binding Identity}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock FontSize="9.8" FontWeight="Bold" Text="Failed" />
                                            <ItemsControl ItemsSource="{Binding SelectedEntry.Attempt.FailedItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="9.6" Text="{Binding Identity}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock FontSize="9.8" FontWeight="Bold" Text="Unprocessed" />
                                            <ItemsControl ItemsSource="{Binding SelectedEntry.Attempt.UnprocessedItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="9.6" Text="{Binding Identity}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4"
                                           FontSize="9.7"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CiaAccentBrush}"
                                           Text="VIEWER" />
                                <CheckBox Margin="0,3"
                                          Content="Auto-follow newest"
                                          IsChecked="False"
                                          IsEnabled="False"
                                          ToolTip="Continuous raw-log following is not available." />
                                <CheckBox x:Name="WrapLongMessagesCheckBox"
                                          Margin="0,3"
                                          Content="Wrap long messages"
                                          IsChecked="{Binding WrapLongMessages, Mode=TwoWay}" />
                                <CheckBox x:Name="CompactRowsCheckBox"
                                          Margin="0,3"
                                          Content="Compact rows"
                                          IsChecked="{Binding CompactRows, Mode=TwoWay}" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Margin="0,0,5,5"
                                            Command="{Binding OpenLogsFolderCommand}"
                                            Content="Open Logs Folder"
                                            Style="{StaticResource SettingsCompactButtonStyle}" />
                                    <Button x:Name="ExportVisibleButton"
                                            Margin="0,0,0,5"
                                            Content="Export Visible…"
                                            IsEnabled="{Binding IsExportVisibleAvailable}"
                                            Style="{StaticResource SettingsCompactButtonStyle}"
                                            ToolTip="Log export is not available." />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="SettingsSide"
                    Grid.Column="2"
                    Style="{StaticResource CiaPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CiaPanelHeaderStyle}">
                        <Grid>
                            <TextBlock Style="{StaticResource CiaPanelTitleTextStyle}" Text="SETTINGS" />
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource CiaSecondaryTextStyle}"
                                       Text="Configuration and utilities" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="8" Background="{StaticResource CiaPanelAlternateBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.65*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="0.92*" MinWidth="220" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Margin="0,0,0,6"
                                        Padding="6,5"
                                        Background="{StaticResource CiaNoteBackgroundBrush}"
                                        BorderBrush="{StaticResource CiaDividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <TextBlock FontSize="9.8"
                                               Foreground="{StaticResource CiaTextSecondaryBrush}"
                                               Text="{Binding SettingsPersistenceText}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Padding="8,6" BorderBrush="{StaticResource CiaBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <TextBlock FontSize="10.7" FontWeight="Bold" Text="GENERAL" />
                                                <Button x:Name="ResetDefaultsButton"
                                                        HorizontalAlignment="Right"
                                                        Content="Reset to Defaults"
                                                        IsEnabled="{Binding AreFutureSettingsActionsAvailable}"
                                                        Style="{StaticResource CiaGhostButtonStyle}"
                                                        ToolTip="Persistent Settings and reset behavior are not available yet." />
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="126" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="5" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CiaSecondaryTextStyle}" Text="Archive nesting depth" />
                                            <TextBox Grid.Column="1"
                                                     IsEnabled="False"
                                                     Style="{StaticResource CiaTextInputStyle}"
                                                     Text="{Binding DefaultArchiveNestingDepth, Mode=OneWay}" />
                                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Style="{StaticResource CiaSecondaryTextStyle}" Text="Default blacklist" />
                                            <TextBox Grid.Row="2"
                                                     Grid.Column="1"
                                                     IsEnabled="False"
                                                     Style="{StaticResource CiaTextInputStyle}"
                                                     Text="{Binding DefaultBlacklistText, Mode=OneWay}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Padding="8,6" BorderBrush="{StaticResource CiaBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <TextBlock FontSize="10.7" FontWeight="Bold" Text="MANAGED STORAGE" />
                                                <Button HorizontalAlignment="Right"
                                                        Content="Open App Data"
                                                        IsEnabled="False"
                                                        Style="{StaticResource CiaGhostButtonStyle}" />
                                            </Grid>
                                        </Border>
                                        <ItemsControl Grid.Row="1" Margin="8,6" ItemsSource="{Binding ManagedStoragePaths}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="65" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" FontSize="9.8" FontWeight="SemiBold" Text="{Binding Name}" />
                                                        <Border Grid.Column="1"
                                                                Height="25"
                                                                Padding="6,0"
                                                                Background="{StaticResource CiaPanelAlternateBrush}"
                                                                BorderBrush="{StaticResource CiaBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6">
                                                            <TextBlock VerticalAlignment="Center"
                                                                       FontFamily="Consolas"
                                                                       FontSize="9.2"
                                                                       Text="{Binding Path}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Path}" />
                                                        </Border>
                                                        <Button Grid.Column="2"
                                                                Width="46"
                                                                Margin="5,0,0,0"
                                                                Command="{Binding DataContext.OpenLogsFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Content="Open"
                                                                IsEnabled="{Binding CanOpen}"
                                                                Style="{StaticResource SettingsCompactButtonStyle}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>
                                            <Border Padding="8,6" BorderBrush="{StaticResource CiaBorderBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock FontSize="10.7" FontWeight="Bold" Text="WORKING STATE &amp; RECOVERY" />
                                            </Border>
                                            <StackPanel Margin="8,7">
                                                <TextBlock Style="{StaticResource CiaSecondaryTextStyle}"
                                                           Text="Working-state save, restore and unresolved-path management are not available yet."
                                                           TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Button x:Name="SaveStateButton" Margin="0,0,5,5" Content="Save State…" IsEnabled="False" Style="{StaticResource SettingsCompactButtonStyle}" />
                                                    <Button Margin="0,0,5,5" Content="Open State…" IsEnabled="False" Style="{StaticResource SettingsCompactButtonStyle}" />
                                                    <Button Margin="0,0,0,5" Content="Manage…" IsEnabled="False" Style="{StaticResource SettingsCompactButtonStyle}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>
                                            <Border Padding="8,6" BorderBrush="{StaticResource CiaBorderBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock FontSize="10.7" FontWeight="Bold" Text="MAINTENANCE &amp; CLEANUP" />
                                            </Border>
                                            <StackPanel Margin="8,7">
                                                <TextBlock Style="{StaticResource CiaSecondaryTextStyle}"
                                                           Text="Storage usage and safe cleanup controls are not available yet."
                                                           TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Button x:Name="CleanTemporaryDataButton" Margin="0,0,5,5" Content="Clean Temporary Data" IsEnabled="False" Style="{StaticResource SettingsCompactButtonStyle}" />
                                                    <Button Margin="0,0,0,5" Content="Clean Session Data" IsEnabled="False" Style="{StaticResource SettingsCompactButtonStyle}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid x:Name="AboutHelpPanel" Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="112" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                                <StackPanel Margin="9">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="38" Height="38" Background="{StaticResource CiaLogoBrush}" CornerRadius="10">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="ExtraBold" Foreground="White" Text="C" />
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="18" FontWeight="Bold" Text="CIA" />
                                            <TextBlock FontSize="10.7" Text="Custom Information Aggregator" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Margin="0,7,0,0" FontSize="9.7" Foreground="{StaticResource CiaAccentBrush}" Text="{Binding VersionText}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="Created by Dragos" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CiaSecondaryTextStyle}" Text="{Binding CopyrightText}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource CiaSecondaryTextStyle}"
                                               Text="Local Windows application · source and derived data remain within the configured local filesystem workflow."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2"
                                    Background="{StaticResource CiaAccentSoftBrush}"
                                    BorderBrush="{StaticResource CiaBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="ExtraBold" Foreground="{StaticResource CiaAccentBrush}" Text="CIA" />
                                    <TextBlock FontSize="8.8" Foreground="{StaticResource CiaTextSecondaryBrush}" Text="FOCUS · EXTRACT · REVIEW" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="4" Style="{StaticResource SettingsCardStyle}" Margin="0">
                                <StackPanel Margin="7">
                                    <TextBlock Margin="2,0,0,5" FontSize="10.7" FontWeight="Bold" Text="HELP &amp; ABOUT" />
                                    <Button Content="User Manual" IsEnabled="False" Style="{StaticResource SettingsHelpButtonStyle}" ToolTip="No documentation destination is configured." />
                                    <Button Content="Installation Guide" IsEnabled="False" Style="{StaticResource SettingsHelpButtonStyle}" ToolTip="No documentation destination is configured." />
                                    <Button Content="Documentation" IsEnabled="False" Style="{StaticResource SettingsHelpButtonStyle}" ToolTip="No documentation destination is configured." />
                                    <Button Content="Release Notes / What's New" IsEnabled="False" Style="{StaticResource SettingsHelpButtonStyle}" ToolTip="No documentation destination is configured." />
                                    <Button Content="Support" IsEnabled="False" Style="{StaticResource SettingsHelpButtonStyle}" ToolTip="No support destination is configured." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
