<UserControl x:Class="CIA.Desktop.Views.SettingsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Settings processing history workspace">
    <UserControl.Resources>
        <Style x:Key="HistoryModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CiaButtonStyle}">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="HistoryListStyle" TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource CiaPanelBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="HistoryItemListStyle" TargetType="ItemsControl">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource CiaTextPrimaryBrush}"
                                       Text="{Binding Identity}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Identity}" />
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       Style="{StaticResource CiaSecondaryTextStyle}"
                                       Text="{Binding State}" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource CiaWorkspaceMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CiaPanelStyle}">
            <Grid Margin="12,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource CiaPanelTitleTextStyle}"
                               Text="SETTINGS / PROCESSING HISTORY" />
                    <TextBlock Margin="0,3,0,0"
                               Style="{StaticResource CiaSecondaryTextStyle}"
                               Text="Review retained processing attempts and recorded issues." />
                </StackPanel>
                <Button Grid.Column="1"
                        AutomationProperties.Name="Refresh processing history"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        Style="{StaticResource CiaButtonStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ShowHistoryCommand}"
                        Content="History">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource HistoryModeButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHistorySelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CiaAccentSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource CiaAccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource CiaAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding ShowIssuesCommand}"
                        Content="Issues">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource HistoryModeButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIssuesSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CiaAccentSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource CiaAccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource CiaAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="10,7"
                    Background="{StaticResource CiaWarningSoftBrush}"
                    BorderBrush="{StaticResource CiaWarningBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CiaControlCornerRadius}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasReadProblem}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Foreground="{StaticResource CiaWarningBrush}"
                           Text="{Binding ReadProblem}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHistorySelected}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="500" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CiaPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CiaPanelHeaderStyle}">
                            <TextBlock Style="{StaticResource CiaPanelTitleTextStyle}"
                                       Text="Processing attempts" />
                        </Border>
                        <ListView Grid.Row="1"
                                  AutomationProperties.Name="Processing attempt history"
                                  ItemsSource="{Binding Attempts}"
                                  SelectedItem="{Binding SelectedAttempt, Mode=TwoWay}"
                                  Style="{StaticResource HistoryListStyle}">
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Width="132"
                                                    DisplayMemberBinding="{Binding RecordedAtLocal, StringFormat={}{0:g}}"
                                                    Header="Time" />
                                    <GridViewColumn Width="145"
                                                    DisplayMemberBinding="{Binding OperationName}"
                                                    Header="Operation" />
                                    <GridViewColumn Width="155"
                                                    DisplayMemberBinding="{Binding Outcome}"
                                                    Header="Outcome" />
                                    <GridViewColumn Width="78"
                                                    DisplayMemberBinding="{Binding SuccessfulCount}"
                                                    Header="Successful" />
                                    <GridViewColumn Width="58"
                                                    DisplayMemberBinding="{Binding FailedCount}"
                                                    Header="Failed" />
                                    <GridViewColumn Width="82"
                                                    DisplayMemberBinding="{Binding UnprocessedCount}"
                                                    Header="Unprocessed" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Grid.Row="1"
                                   Margin="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding HistoryEmptyMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource CiaSecondaryTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CiaPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CiaPanelHeaderStyle}">
                            <TextBlock Style="{StaticResource CiaPanelTitleTextStyle}"
                                       Text="Attempt details" />
                        </Border>
                        <ScrollViewer Grid.Row="1"
                                      Padding="10"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedAttempt}">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource CiaTextPrimaryBrush}"
                                           Text="{Binding OperationName}" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="{Binding Outcome}" />
                                <TextBlock Margin="0,10,0,0"
                                           FontWeight="SemiBold"
                                           Text="Stage" />
                                <TextBlock Margin="0,2,0,0"
                                           Text="{Binding Stage}"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,12,0,0"
                                           FontWeight="SemiBold"
                                           Text="Processed successfully" />
                                <ItemsControl ItemsSource="{Binding SuccessfulItems}"
                                              Style="{StaticResource HistoryItemListStyle}" />
                                <TextBlock FontWeight="SemiBold" Text="Failed" />
                                <ItemsControl ItemsSource="{Binding FailedItems}"
                                              Style="{StaticResource HistoryItemListStyle}" />
                                <TextBlock FontWeight="SemiBold" Text="Unprocessed" />
                                <ItemsControl ItemsSource="{Binding UnprocessedItems}"
                                              Style="{StaticResource HistoryItemListStyle}" />

                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="Operation ID" />
                                <TextBlock Margin="0,2,0,0"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="{StaticResource CiaTextMutedBrush}"
                                           Text="{Binding OperationId}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIssuesSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="500" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CiaPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CiaPanelHeaderStyle}">
                            <TextBlock Style="{StaticResource CiaPanelTitleTextStyle}"
                                       Text="Recorded issues" />
                        </Border>
                        <ListView Grid.Row="1"
                                  AutomationProperties.Name="Recorded processing issues"
                                  ItemsSource="{Binding Issues}"
                                  SelectedItem="{Binding SelectedIssue, Mode=TwoWay}"
                                  Style="{StaticResource HistoryListStyle}">
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Width="132"
                                                    DisplayMemberBinding="{Binding RecordedAtLocal, StringFormat={}{0:g}}"
                                                    Header="Time" />
                                    <GridViewColumn Width="130"
                                                    DisplayMemberBinding="{Binding OperationName}"
                                                    Header="Operation" />
                                    <GridViewColumn Width="170"
                                                    DisplayMemberBinding="{Binding AffectedItem}"
                                                    Header="Affected item" />
                                    <GridViewColumn Width="300"
                                                    DisplayMemberBinding="{Binding Description}"
                                                    Header="Description" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Grid.Row="1"
                                   Margin="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding IssuesEmptyMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource CiaSecondaryTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasIssues}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CiaPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CiaPanelHeaderStyle}">
                            <TextBlock Style="{StaticResource CiaPanelTitleTextStyle}"
                                       Text="Issue details" />
                        </Border>
                        <ScrollViewer Grid.Row="1"
                                      Padding="10"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedIssue}">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource CiaTextPrimaryBrush}"
                                           Text="{Binding Description}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="Operation" />
                                <TextBlock Text="{Binding OperationName}" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="Stage" />
                                <TextBlock Text="{Binding Stage}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="Affected item" />
                                <TextBlock Text="{Binding AffectedItem}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="Item / outcome state" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ItemState}" />
                                    <TextBlock Margin="8,0,0,0" Text="{Binding Outcome}" />
                                </StackPanel>

                                <Expander Margin="0,14,0,0"
                                          Header="Technical details">
                                    <StackPanel Margin="0,7,0,0">
                                        <TextBlock Style="{StaticResource CiaSecondaryTextStyle}"
                                                   Text="Failure code" />
                                        <TextBlock Text="{Binding FailureCode}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource CiaSecondaryTextStyle}"
                                                   Text="Technical detail" />
                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="10.5"
                                                   Text="{Binding TechnicalDetail}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource CiaSecondaryTextStyle}"
                                                   Text="Correlation" />
                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="10"
                                                   Foreground="{StaticResource CiaTextMutedBrush}"
                                                   Text="{Binding OperationId, StringFormat=Operation {0}}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="10"
                                                   Foreground="{StaticResource CiaTextMutedBrush}"
                                                   Text="{Binding DiagnosticId, StringFormat=Diagnostic {0}}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
