<UserControl x:Class="CIA.Desktop.Views.DatabaseWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:CIA.Desktop.Presentation"
             xmlns:workflow="clr-namespace:CIA.Desktop.Workflow"
             x:Name="DatabaseViewRoot"
             Loaded="OnViewLoaded"
             Unloaded="OnViewUnloaded"
             SizeChanged="OnViewSizeChanged"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="DatabaseStateBadgeStyle"
               TargetType="Border"
               BasedOn="{StaticResource CiaNeutralStateBadgeStyle}">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DatabaseStatus}"
                             Value="{x:Static workflow:WorkflowArtifactStatus.Current}">
                    <Setter Property="Background" Value="#FFEAF7EF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DatabaseStatus}"
                             Value="{x:Static workflow:WorkflowArtifactStatus.Stale}">
                    <Setter Property="Background" Value="{StaticResource CiaWarningSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DatabaseSectionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource CiaAccentBrush}" />
        </Style>
        <Style x:Key="ExtractionStateBadgeStyle"
               TargetType="Border"
               BasedOn="{StaticResource CiaNeutralStateBadgeStyle}">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExtractionReviewState}"
                             Value="{x:Static presentation:ExtractionReviewState.Ready}">
                    <Setter Property="Background" Value="#FFEAF7EF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ExtractionReviewState}"
                             Value="{x:Static presentation:ExtractionReviewState.ReadyWithIssues}">
                    <Setter Property="Background" Value="{StaticResource CiaWarningSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ExtractionReviewState}"
                             Value="{x:Static presentation:ExtractionReviewState.OutOfDate}">
                    <Setter Property="Background" Value="{StaticResource CiaWarningSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DatabaseGridHeaderTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource CiaSourceHeaderTextStyle}">
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="DatabaseColumnResizeThumbStyle"
               TargetType="Thumb"
               BasedOn="{StaticResource CiaColumnResizeThumbStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanResizeWithNext}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DatabaseExcelHeaderInputStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource CiaTextInputStyle}">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="6,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasExcelHeaderOverride}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource CiaAccentBrush}" />
                    <Setter Property="Background" Value="#FFF7F6FF" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource CiaWorkspaceMargin}" MinHeight="0">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="DatabaseGridRow" Height="5*" />
            <RowDefinition Height="8" />
            <RowDefinition x:Name="DatabaseLowerRow" Height="3*" />
        </Grid.RowDefinitions>

        <Border x:Name="DatabaseGridPanel"
                Grid.Row="0"
                ClipToBounds="True"
                Style="{StaticResource CiaPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CiaPanelHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource CiaPanelTitleTextStyle}"
                                   Text="DATABASE" />
                        <Border Grid.Column="1"
                                Margin="8,0"
                                Style="{StaticResource DatabaseStateBadgeStyle}">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="10.7"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CiaTextSecondaryBrush}"
                                       Text="{Binding DatabaseStateText}" />
                        </Border>
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CiaSecondaryTextStyle}"
                                   Text="{Binding DatabaseStateContext}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="ExportToExcelButton"
                                Grid.Column="3"
                                AutomationProperties.Name="Export to Excel"
                                Command="{Binding ExportToExcelCommand}"
                                Content="▣ Export to Excel"
                                Style="{StaticResource CiaPrimaryButtonStyle}"
                                ToolTip="Export the current workbook batch to the selected destination." />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Padding="8,6"
                        BorderBrush="{StaticResource CiaBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="160"
                                     Margin="0,0,6,0"
                                     AutomationProperties.Name="Search Database rows"
                                     Style="{StaticResource CiaTextInputStyle}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Width="92"
                                      Margin="0,0,6,0"
                                      AutomationProperties.Name="Database row inclusion filter"
                                      ItemsSource="{Binding RowInclusionFilters}"
                                      SelectedItem="{Binding RowInclusionFilter}" />
                            <Button x:Name="ColumnsButton"
                                    AutomationProperties.Name="Configure Database columns"
                                    Click="OnColumnsClick"
                                    Content="▥ Columns"
                                    Style="{StaticResource CiaButtonStyle}" />
                            <Button Margin="4,0,0,0"
                                    Command="{Binding IncludeVisibleRowsCommand}"
                                    Content="Include visible"
                                    Style="{StaticResource CiaGhostButtonStyle}" />
                            <Button Margin="0,0,6,0"
                                    Command="{Binding ExcludeVisibleRowsCommand}"
                                    Content="Exclude visible"
                                    Style="{StaticResource CiaGhostButtonStyle}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CiaTextPrimaryBrush}"
                                       Text="{Binding RecordCountText}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CiaSecondaryTextStyle}"
                                       Text="{Binding ColumnCountText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Popup x:Name="ColumnsPopup"
                       AllowsTransparency="True"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=ColumnsButton}"
                       StaysOpen="False">
                    <Border Width="510"
                            Margin="0,4,0,0"
                            Padding="9"
                            Background="{StaticResource CiaPanelBrush}"
                            BorderBrush="{StaticResource CiaBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28"
                                              Opacity="0.16"
                                              ShadowDepth="8"
                                              Color="#FF141E32" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource DatabaseSectionTextStyle}"
                                       Text="DATABASE COLUMNS" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,4,0,6"
                                       Style="{StaticResource CiaSecondaryTextStyle}"
                                       Text="Names, inclusion and order apply to Database review and Excel. Width affects CIA only."
                                       TextWrapping="Wrap" />
                            <Grid Grid.Row="2" Margin="2,0,2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Style="{StaticResource CiaSourceHeaderTextStyle}" Text="Column" />
                                <TextBlock Grid.Column="2" Style="{StaticResource CiaSourceHeaderTextStyle}" Text="SourceId" />
                                <TextBlock Grid.Column="3" Style="{StaticResource CiaSourceHeaderTextStyle}" Text="Actions" />
                            </Grid>
                            <ScrollViewer Grid.Row="3"
                                          MaxHeight="300"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ColumnChoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="42">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="82" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox VerticalAlignment="Center"
                                                          AutomationProperties.Name="Include Database column"
                                                          IsChecked="{Binding IsIncluded}" />
                                                <Grid Grid.Column="1" Margin="2,2,4,2" VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <Button HorizontalContentAlignment="Left"
                                                                Padding="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Command="{Binding BeginRenameCommand}"
                                                                Content="{Binding DisplayName}"
                                                                FontWeight="SemiBold"
                                                                ToolTip="{Binding OriginalName, StringFormat=Original name: {0}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CiaGhostButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <TextBlock FontSize="9"
                                                                   Foreground="{StaticResource CiaTextMutedBrush}"
                                                                   Text="{Binding Category}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBox AutomationProperties.Name="Edit Database and Excel column name"
                                                                 KeyDown="OnColumnNameEditKeyDown"
                                                                 LostKeyboardFocus="OnColumnNameEditLostFocus"
                                                                 Style="{StaticResource CiaTextInputStyle}"
                                                                 Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock FontSize="9"
                                                                   Foreground="{StaticResource CiaDangerBrush}"
                                                                   Text="{Binding ValidationText}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <CheckBox Grid.Column="2"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          AutomationProperties.Name="Include SourceId companion"
                                                          IsChecked="{Binding IsSourceIdIncluded}">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SupportsSourceId}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                                <StackPanel Grid.Column="3"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal">
                                                    <Button Width="24"
                                                            Height="24"
                                                            Margin="0,0,2,0"
                                                            Padding="0"
                                                            AutomationProperties.Name="Reset column name"
                                                            Command="{Binding ResetNameCommand}"
                                                            Content="&#x21BA;"
                                                            ToolTip="Reset this column name">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource CiaButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasNameOverride}" Value="False">
                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Width="24"
                                                            Height="24"
                                                            Margin="0,0,2,0"
                                                            Padding="0"
                                                            Command="{Binding DataContext.MoveColumnChoiceUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="↑"
                                                            Style="{StaticResource CiaButtonStyle}" />
                                                    <Button Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            Command="{Binding DataContext.MoveColumnChoiceDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="↓"
                                                            Style="{StaticResource CiaButtonStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Grid.Row="4"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ResetColumnLayoutCommand}"
                                    Content="Reset layout"
                                    Style="{StaticResource CiaGhostButtonStyle}" />
                        </Grid>
                    </Border>
                </Popup>

                <Grid Grid.Row="2" MinHeight="0" Background="{StaticResource CiaPanelBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="DatabaseReviewHorizontalScrollViewer"
                                  Grid.Column="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  ScrollChanged="OnDatabaseReviewHorizontalScrollChanged"
                                  VerticalScrollBarVisibility="Disabled">
                        <Grid MinWidth="{Binding ElementName=DatabaseReviewHorizontalScrollViewer, Path=ActualWidth}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource CiaPanelAlternateBrush}"
                                    BorderBrush="{StaticResource CiaBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="72"
                                            BorderBrush="{StaticResource CiaDividerBrush}"
                                            BorderThickness="0,0,1,0">
                                        <TextBlock HorizontalAlignment="Center"
                                                   Style="{StaticResource DatabaseGridHeaderTextStyle}"
                                                   Text="Include / #" />
                                    </Border>
                                    <ItemsControl x:Name="DynamicDatabaseHeaders"
                                                  ItemsSource="{Binding VisibleColumns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}"
                                                        BorderBrush="{StaticResource CiaDividerBrush}"
                                                        BorderThickness="0,0,1,0">
                                                    <Grid>
                                                        <TextBlock Style="{StaticResource DatabaseGridHeaderTextStyle}"
                                                                   Text="{Binding DisplayName}"
                                                                   ToolTip="{Binding DatabaseField, StringFormat=Original name: {0}}" />
                                                        <Thumb Style="{StaticResource DatabaseColumnResizeThumbStyle}"
                                                               DragStarted="OnDatabaseColumnResizeStarted"
                                                               DragDelta="OnDatabaseColumnResizeDelta"
                                                               DragCompleted="OnDatabaseColumnResizeCompleted" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl x:Name="DatabaseMetadataHeaders"
                                                  ItemsSource="{Binding VisibleMetadataColumns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}"
                                                        BorderBrush="{StaticResource CiaDividerBrush}"
                                                        BorderThickness="0,0,1,0">
                                                    <Grid>
                                                        <TextBlock Style="{StaticResource DatabaseGridHeaderTextStyle}"
                                                                   Text="{Binding DisplayName}" />
                                                        <Thumb Style="{StaticResource DatabaseColumnResizeThumbStyle}"
                                                               DragStarted="OnDatabaseColumnResizeStarted"
                                                               DragDelta="OnDatabaseColumnResizeDelta"
                                                               DragCompleted="OnDatabaseColumnResizeCompleted" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="DatabaseReviewRows"
                                     Grid.Row="1"
                                     ItemsSource="{Binding Records}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.ScrollChanged="OnDatabaseReviewScrollChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="30">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource CiaWarningSoftBrush}" />
                                                                <Setter Property="ToolTip" Value="This row contains preserved conflicting mapped values." />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="72"
                                                        BorderBrush="{StaticResource CiaDividerBrush}"
                                                        BorderThickness="0,0,1,1">
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                        <CheckBox VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsIncluded, Mode=OneWay}"
                                                                  Command="{Binding DataContext.SetRowIncludedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}">
                                                            <CheckBox.Style>
                                                                <Style TargetType="CheckBox">
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                                            <Setter Property="IsEnabled" Value="False" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </CheckBox.Style>
                                                        </CheckBox>
                                                        <TextBlock Margin="5,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource CiaTextMutedBrush}"
                                                                   Text="{Binding Ordinal}" />
                                                    </StackPanel>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="{Binding Column.Width}"
                                                                    BorderBrush="{StaticResource CiaDividerBrush}"
                                                                    BorderThickness="0,0,1,1"
                                                                    ClipToBounds="True"
                                                                    ToolTip="{Binding InspectionText}"
                                                                    ToolTipService.InitialShowDelay="600"
                                                                    ToolTipService.ShowDuration="60000">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource CiaWarningSoftBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Margin="8,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource CiaTextPrimaryBrush}"
                                                                           Text="{Binding DisplayValue}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding MetadataCells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="{Binding Column.Width}"
                                                                    BorderBrush="{StaticResource CiaDividerBrush}"
                                                                    BorderThickness="0,0,1,1"
                                                                    ToolTip="{Binding Value}">
                                                                <TextBlock Margin="8,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource CiaTextMutedBrush}"
                                                                           Text="{Binding Value}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ScrollViewer>
                    <ScrollBar x:Name="DatabaseReviewVerticalScrollBar"
                               Grid.Column="1"
                               Width="14"
                               Orientation="Vertical"
                               SmallChange="30"
                               ValueChanged="OnDatabaseReviewVerticalScrollBarValueChanged" />
                    <Border x:Name="DatabaseColumnSizeFeedback"
                            Margin="0,34,12,0"
                            Padding="8,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Panel.ZIndex="4"
                            Background="{StaticResource CiaTextPrimaryBrush}"
                            CornerRadius="5"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <TextBlock x:Name="DatabaseColumnSizeFeedbackText"
                                   Foreground="White" />
                    </Border>
                    <StackPanel Margin="0,30,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasReviewRows}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource CiaEmptyStateTitleTextStyle}"
                                   Text="{Binding EmptyStateTitle}" />
                        <TextBlock Margin="0,5,0,0"
                                   MaxWidth="560"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource CiaSecondaryTextStyle}"
                                   Text="{Binding EmptyStateDetail}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="3"
                        Padding="8,4,8,0"
                        Background="{StaticResource CiaPanelAlternateBrush}"
                        BorderBrush="{StaticResource CiaBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    <ListBox x:Name="DatabaseSourceSetTabs"
                             ItemsSource="{Binding Datasets}"
                             SelectedItem="{Binding SelectedDataset, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="MinWidth" Value="108" />
                                <Setter Property="Margin" Value="0,0,4,0" />
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource CiaTextSecondaryBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0,0,0,2" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource CiaPanelBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource CiaAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource CiaAccentBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Context}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,4"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CiaSecondaryTextStyle}"
                                       Text="Current output" />
                            <Border MinWidth="180"
                                    Padding="8,4"
                                    Background="{StaticResource CiaPanelBrush}"
                                    BorderBrush="{StaticResource CiaBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    ToolTip="{Binding SelectedRowFamily.DisplayName, StringFormat=Internal structure: {0}}">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding SelectedDataset.DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="DatabaseLowerRegion" Grid.Row="2" MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="LowerTabs" Height="34" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ExportFieldsTabButton"
                        Click="OnExportFieldsTabClick"
                        Content="Export Fields"
                        Style="{StaticResource CiaButtonStyle}" />
                <Button x:Name="ExcelExportTabButton"
                        Grid.Column="1"
                        Click="OnExcelExportTabClick"
                        Content="Excel Export"
                        Style="{StaticResource CiaButtonStyle}" />
            </Grid>

            <Grid x:Name="LowerPanelGrid" Grid.Row="1" MinHeight="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ExportFieldsColumn" Width="*" />
                    <ColumnDefinition x:Name="LowerPanelGapColumn" Width="8" />
                    <ColumnDefinition x:Name="ExcelExportColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ExportFieldsPanel"
                        Grid.Column="0"
                        ClipToBounds="True"
                        Style="{StaticResource CiaPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Padding="8,6" Style="{StaticResource CiaPanelHeaderStyle}">
                            <Grid>
                                <TextBlock Style="{StaticResource CiaPanelTitleTextStyle}"
                                           Text="EXCEL OUTPUT CONFIGURATION" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="{Binding ExportFieldCountText}" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1"
                                Padding="8,6"
                                BorderBrush="{StaticResource CiaDividerBrush}"
                                BorderThickness="0,0,0,1">
                            <WrapPanel>
                                <Border Margin="0,0,7,4" Padding="7,5" BorderBrush="{StaticResource CiaBorderBrush}" BorderThickness="1" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,4" Style="{StaticResource CiaSecondaryTextStyle}" Text="OUTPUT INCLUSION" />
                                        <CheckBox x:Name="ExportEnabledToggle"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Include current output in export"
                                                  Content="Include current output"
                                                  IsChecked="{Binding IsSelectedSetExportEnabled}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,7,4" Padding="7,5" BorderBrush="{StaticResource CiaBorderBrush}" BorderThickness="1" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,4" Style="{StaticResource CiaSecondaryTextStyle}" Text="WORKBOOK" />
                                        <WrapPanel>
                                            <ComboBox x:Name="WorkbookDefinitionSelector"
                                                      Width="155"
                                                      AutomationProperties.Name="Select existing workbook definition"
                                                      DisplayMemberPath="FileName"
                                                      ItemsSource="{Binding WorkbookDefinitions}"
                                                      SelectedItem="{Binding SelectedExportWorkbook, Mode=TwoWay}"
                                                      ToolTip="Select an existing workbook definition." />
                                            <Button x:Name="CreateWorkbookDefinitionButton"
                                                    Width="30"
                                                    Margin="4,0,7,0"
                                                    AutomationProperties.Name="Create workbook definition"
                                                    Command="{Binding CreateExportWorkbookCommand}"
                                                    Content="+"
                                                    Style="{StaticResource CiaButtonStyle}"
                                                    ToolTip="Create a new workbook definition." />
                                            <Button x:Name="RenameWorkbookButton"
                                                    Padding="8,3"
                                                    AutomationProperties.Name="Rename selected workbook"
                                                    Command="{Binding BeginWorkbookRenameCommand}"
                                                    Content="Rename">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource CiaGhostButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWorkbookNameEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBox x:Name="WorkbookNameInput"
                                                     Width="170"
                                                     Margin="4,0,0,0"
                                                     AutomationProperties.Name="Edit selected workbook filename"
                                                     KeyDown="OnWorkbookNameEditKeyDown"
                                                     LostKeyboardFocus="OnWorkbookNameEditLostFocus"
                                                     Text="{Binding WorkbookNameEditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource CiaTextInputStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWorkbookNameEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </WrapPanel>
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="9"
                                                   Foreground="{StaticResource CiaDangerBrush}"
                                                   Text="{Binding WorkbookRenameValidationText}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,0,4" Padding="7,5" BorderBrush="{StaticResource CiaBorderBrush}" BorderThickness="1" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,4" Style="{StaticResource CiaSecondaryTextStyle}" Text="WORKSHEET" />
                                        <WrapPanel>
                                            <TextBox x:Name="WorksheetNameInput"
                                                     Width="150"
                                                     AutomationProperties.Name="Worksheet name"
                                                     Style="{StaticResource CiaTextInputStyle}"
                                                     Text="{Binding SelectedWorksheetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Width="30"
                                                    Margin="5,0,0,0"
                                                    AutomationProperties.Name="Move worksheet earlier"
                                                    Command="{Binding MoveWorksheetUpCommand}"
                                                    Content="&#x2191;"
                                                    Style="{StaticResource CiaButtonStyle}"
                                                    ToolTip="Move this worksheet earlier in the workbook." />
                                            <Button Width="30"
                                                    Margin="3,0,0,0"
                                                    AutomationProperties.Name="Move worksheet later"
                                                    Command="{Binding MoveWorksheetDownCommand}"
                                                    Content="&#x2193;"
                                                    Style="{StaticResource CiaButtonStyle}"
                                                    ToolTip="Move this worksheet later in the workbook." />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Border>
                        <Grid x:Name="LegacyExportHeaderOverrides" Grid.Row="2" MinHeight="0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="27" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="7,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource CiaSourceHeaderTextStyle}" Text="Column" />
                                <TextBlock Grid.Column="1" Style="{StaticResource CiaSourceHeaderTextStyle}" Text="Excel Header (Override)" />
                                <TextBlock Grid.Column="2" Style="{StaticResource CiaSourceHeaderTextStyle}" Text="SourceId" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl x:Name="ExportColumnRows" ItemsSource="{Binding ExportColumns}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="34" Margin="7,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*" />
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="58" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,8,0"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding DatabaseField}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBox Grid.Column="1"
                                                             Margin="0,4,8,4"
                                                             AutomationProperties.Name="Excel Header Override"
                                                             Style="{StaticResource DatabaseExcelHeaderInputStyle}"
                                                             Text="{Binding ExcelHeader, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                    <CheckBox Grid.Column="2"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              AutomationProperties.Name="Export SourceId companion"
                                                              IsChecked="{Binding IsSourceIdExported}"
                                                              ToolTip="{Binding SourceIdExportHeader}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl x:Name="ExportMetadataRows"
                                                  ItemsSource="{Binding ExportMetadataFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="34" Margin="7,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*" />
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="58" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,8,0"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBox Grid.Column="1"
                                                             Margin="0,4,8,4"
                                                             AutomationProperties.Name="Metadata Excel header"
                                                             Style="{StaticResource DatabaseExcelHeaderInputStyle}"
                                                             Text="{Binding ExcelHeader, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="9,7">
                                <TextBlock Style="{StaticResource DatabaseSectionTextStyle}"
                                           Text="DESTINATION" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource CiaSecondaryTextStyle}"
                                               Text="Save to" />
                                    <TextBox Grid.Column="1"
                                             AutomationProperties.Name="Excel output folder"
                                             IsReadOnly="True"
                                             Style="{StaticResource CiaTextInputStyle}"
                                             Text="{Binding OutputFolder}" />
                                    <Button x:Name="BrowseOutputFolderButton"
                                            Grid.Column="2"
                                            Margin="5,0,0,0"
                                            AutomationProperties.Name="Browse for Excel export destination"
                                            Command="{Binding BrowseOutputFolderCommand}"
                                            Content="Browse…"
                                            Style="{StaticResource CiaButtonStyle}"
                                            ToolTip="Change the export destination without writing files." />
                                </Grid>
                                <WrapPanel Margin="0,7,0,0">
                                    <CheckBox Margin="0,0,18,0"
                                              Content="Ask where to save each time"
                                              IsChecked="{Binding AlwaysAskWhereToExport}" />
                                    <CheckBox x:Name="OpenFilesAfterExportToggle"
                                              Content="Open file(s) after export"
                                              IsChecked="{Binding OpenFilesAfterExport}" />
                                </WrapPanel>
                                <ItemsControl Margin="0,3,0,0"
                                              ItemsSource="{Binding ExportDestinationTargets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CiaSecondaryTextStyle}"
                                                       Text="{Binding}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="WorkbookExportStatusText"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="{Binding WorkbookExportStatusText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="3"
                                Padding="8,6"
                                BorderBrush="{StaticResource CiaDividerBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock x:Name="ExportConfigurationValidationText"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="{Binding ExportConfigurationValidationText}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="ExcelExportPanel"
                        Grid.Column="2"
                        ClipToBounds="True"
                        Style="{StaticResource CiaPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="8,6" Style="{StaticResource CiaPanelHeaderStyle}">
                            <TextBlock Style="{StaticResource CiaPanelTitleTextStyle}"
                                       Text="EXCEL EXPORT" />
                        </Border>
                        <Border Grid.Row="1"
                                Padding="9,7"
                                BorderBrush="{StaticResource CiaDividerBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   Style="{StaticResource DatabaseSectionTextStyle}"
                                                   Text="EXTRACTION RESULT" />
                                        <Border Margin="8,0,0,0"
                                                Style="{StaticResource ExtractionStateBadgeStyle}">
                                            <TextBlock x:Name="ExtractionReviewStateText"
                                                       VerticalAlignment="Center"
                                                       FontSize="10.7"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource CiaTextSecondaryBrush}"
                                                       Text="{Binding ExtractionReviewStateText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource CiaSecondaryTextStyle}"
                                               Text="{Binding ExtractionReviewContext}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ExtractionReviewContext}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="ExcelSettingsGrid" Margin="9,7" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ExcelLocalColumn" Width="*" />
                                    <ColumnDefinition x:Name="ExcelSettingsGapColumn" Width="12" />
                                    <ColumnDefinition x:Name="ExcelInfoColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="ExcelTopRow" Height="Auto" />
                                    <RowDefinition x:Name="ExcelStackGapRow" Height="0" />
                                    <RowDefinition x:Name="ExcelBottomRow" Height="0" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="ExcelLocalSettings" Grid.Column="0">
                                    <TextBlock Style="{StaticResource DatabaseSectionTextStyle}" Text="LOCAL SETTINGS" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CiaSecondaryTextStyle}" Text="Output folder" />
                                        <TextBox Grid.Column="1"
                                                 AutomationProperties.Name="Excel output folder"
                                                 Style="{StaticResource CiaTextInputStyle}"
                                                 Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button x:Name="LegacyBrowseOutputFolderButton"
                                                Grid.Column="2"
                                                Margin="5,0,0,0"
                                                AutomationProperties.Name="Browse for Excel output folder"
                                                Command="{Binding BrowseOutputFolderCommand}"
                                                Style="{StaticResource CiaButtonStyle}"
                                                Content="Browse" />
                                    </Grid>
                                    <CheckBox Margin="0,7,0,0"
                                              Content="Always ask where to export"
                                              IsChecked="{Binding AlwaysAskWhereToExport}" />
                                    <TextBlock x:Name="LegacyWorkbookExportStatusText"
                                               Margin="0,7,0,0"
                                               Style="{StaticResource CiaSecondaryTextStyle}"
                                               Text="{Binding WorkbookExportStatusText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="ExcelInfo" Grid.Column="2">
                                    <TextBlock Style="{StaticResource DatabaseSectionTextStyle}" Text="INFO" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,5,7">
                                            <TextBlock Style="{StaticResource CiaSecondaryTextStyle}" Text="Workbook" />
                                            <TextBlock FontWeight="Bold" Text="{Binding SelectedExportWorkbook.FileName}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,7">
                                            <TextBlock Style="{StaticResource CiaSecondaryTextStyle}" Text="Worksheet" />
                                            <TextBlock FontWeight="Bold" Text="{Binding SelectedWorksheetName}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,0,5,0">
                                            <TextBlock Style="{StaticResource CiaSecondaryTextStyle}" Text="Headers" />
                                            <TextBlock FontWeight="Bold" Text="Current names / overrides" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,0,0">
                                            <TextBlock Style="{StaticResource CiaSecondaryTextStyle}" Text="Export fields" />
                                            <TextBlock FontWeight="Bold" Text="{Binding WorkbookExportFieldCountText}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
