<UserControl x:Class="CIA.Desktop.Views.DatabaseWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:CIA.Desktop.Presentation"
             xmlns:workflow="clr-namespace:CIA.Desktop.Workflow"
             x:Name="DatabaseViewRoot"
             Loaded="OnViewLoaded"
             SizeChanged="OnViewSizeChanged"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="DatabaseStateBadgeStyle"
               TargetType="Border"
               BasedOn="{StaticResource CiaNeutralStateBadgeStyle}">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DatabaseStatus}"
                             Value="{x:Static workflow:WorkflowArtifactStatus.Current}">
                    <Setter Property="Background" Value="#FFEAF7EF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DatabaseStatus}"
                             Value="{x:Static workflow:WorkflowArtifactStatus.Stale}">
                    <Setter Property="Background" Value="{StaticResource CiaWarningSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DatabaseSectionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource CiaAccentBrush}" />
        </Style>
        <Style x:Key="ExtractionStateBadgeStyle"
               TargetType="Border"
               BasedOn="{StaticResource CiaNeutralStateBadgeStyle}">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExtractionReviewState}"
                             Value="{x:Static presentation:ExtractionReviewState.Ready}">
                    <Setter Property="Background" Value="#FFEAF7EF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ExtractionReviewState}"
                             Value="{x:Static presentation:ExtractionReviewState.ReadyWithIssues}">
                    <Setter Property="Background" Value="{StaticResource CiaWarningSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ExtractionReviewState}"
                             Value="{x:Static presentation:ExtractionReviewState.OutOfDate}">
                    <Setter Property="Background" Value="{StaticResource CiaWarningSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DatabaseGridHeaderTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource CiaSourceHeaderTextStyle}">
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="DatabaseExcelHeaderInputStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource CiaTextInputStyle}">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="6,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasExcelHeaderOverride}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource CiaAccentBrush}" />
                    <Setter Property="Background" Value="#FFF7F6FF" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource CiaWorkspaceMargin}" MinHeight="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="DatabaseGridPanel"
                Grid.Row="0"
                ClipToBounds="True"
                Style="{StaticResource CiaPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CiaPanelHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource CiaPanelTitleTextStyle}"
                                   Text="DATABASE" />
                        <Border Grid.Column="1"
                                Margin="8,0"
                                Style="{StaticResource DatabaseStateBadgeStyle}">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="10.7"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CiaTextSecondaryBrush}"
                                       Text="{Binding DatabaseStateText}" />
                        </Border>
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CiaSecondaryTextStyle}"
                                   Text="{Binding DatabaseStateContext}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="ExportToExcelButton"
                                Grid.Column="3"
                                AutomationProperties.Name="Export to Excel"
                                Content="▣ Export to Excel"
                                IsEnabled="{Binding IsExportAvailable}"
                                Style="{StaticResource CiaPrimaryButtonStyle}"
                                ToolTip="Excel workbook generation is implemented by a later story." />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Padding="8,6"
                        BorderBrush="{StaticResource CiaBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ColumnsButton"
                                    AutomationProperties.Name="Configure Database columns"
                                    Click="OnColumnsClick"
                                    Content="▥ Columns"
                                    Style="{StaticResource CiaButtonStyle}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CiaTextPrimaryBrush}"
                                       Text="{Binding RecordCountText}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CiaSecondaryTextStyle}"
                                       Text="{Binding ColumnCountText}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="PreviousDatabasePageButton"
                                    MinWidth="74"
                                    AutomationProperties.Name="Previous Database review page"
                                    Command="{Binding PreviousReviewPageCommand}"
                                    Content="Previous"
                                    Style="{StaticResource CiaGhostButtonStyle}" />
                            <TextBlock Margin="8,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CiaSecondaryTextStyle}"
                                       Text="{Binding ReviewPageText}" />
                            <Button x:Name="NextDatabasePageButton"
                                    MinWidth="58"
                                    AutomationProperties.Name="Next Database review page"
                                    Command="{Binding NextReviewPageCommand}"
                                    Content="Next"
                                    Style="{StaticResource CiaGhostButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Popup x:Name="ColumnsPopup"
                       AllowsTransparency="True"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=ColumnsButton}"
                       StaysOpen="False">
                    <Border Width="390"
                            Margin="0,4,0,0"
                            Padding="9"
                            Background="{StaticResource CiaPanelBrush}"
                            BorderBrush="{StaticResource CiaBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28"
                                              Opacity="0.16"
                                              ShadowDepth="8"
                                              Color="#FF141E32" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource DatabaseSectionTextStyle}"
                                       Text="DATABASE COLUMNS" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,4,0,6"
                                       Style="{StaticResource CiaSecondaryTextStyle}"
                                       Text="Visibility, order and width affect CIA presentation only." />
                            <Grid Grid.Row="2" Margin="2,0,2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Style="{StaticResource CiaSourceHeaderTextStyle}" Text="Column" />
                                <TextBlock Grid.Column="2" Style="{StaticResource CiaSourceHeaderTextStyle}" Text="Width" />
                                <TextBlock Grid.Column="3" Style="{StaticResource CiaSourceHeaderTextStyle}" Text="Order" />
                            </Grid>
                            <ScrollViewer Grid.Row="3"
                                          MaxHeight="300"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Columns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="33">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="54" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox VerticalAlignment="Center"
                                                          AutomationProperties.Name="Show Database column"
                                                          IsChecked="{Binding IsVisible}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="2,0,4,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding DatabaseField}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBox Grid.Column="2"
                                                         Width="56"
                                                         Height="24"
                                                         Padding="4,0"
                                                         HorizontalContentAlignment="Right"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding Width, UpdateSourceTrigger=LostFocus}" />
                                                <StackPanel Grid.Column="3"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal">
                                                    <Button Width="24"
                                                            Height="24"
                                                            Margin="0,0,2,0"
                                                            Padding="0"
                                                            Command="{Binding DataContext.MoveColumnUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="↑"
                                                            Style="{StaticResource CiaButtonStyle}" />
                                                    <Button Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            Command="{Binding DataContext.MoveColumnDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="↓"
                                                            Style="{StaticResource CiaButtonStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Grid.Row="4"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ResetColumnLayoutCommand}"
                                    Content="Reset layout"
                                    Style="{StaticResource CiaGhostButtonStyle}" />
                        </Grid>
                    </Border>
                </Popup>

                <Grid Grid.Row="2" MinHeight="0" Background="{StaticResource CiaPanelBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <Grid MinWidth="{Binding ElementName=DatabaseGridPanel, Path=ActualWidth}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource CiaPanelAlternateBrush}"
                                    BorderBrush="{StaticResource CiaBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="48"
                                            BorderBrush="{StaticResource CiaDividerBrush}"
                                            BorderThickness="0,0,1,0">
                                        <TextBlock HorizontalAlignment="Center"
                                                   Style="{StaticResource DatabaseGridHeaderTextStyle}"
                                                   Text="#" />
                                    </Border>
                                    <ItemsControl x:Name="DynamicDatabaseHeaders"
                                                  ItemsSource="{Binding VisibleColumns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}"
                                                        BorderBrush="{StaticResource CiaDividerBrush}"
                                                        BorderThickness="0,0,1,0">
                                                    <TextBlock Style="{StaticResource DatabaseGridHeaderTextStyle}"
                                                               Text="{Binding DatabaseField}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DatabaseReviewRows"
                                              ItemsSource="{Binding Records}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Height="30" Orientation="Horizontal">
                                                <Border Width="48"
                                                        BorderBrush="{StaticResource CiaDividerBrush}"
                                                        BorderThickness="0,0,1,1">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource CiaTextMutedBrush}"
                                                               Text="{Binding Ordinal}" />
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="{Binding Column.Width}"
                                                                    BorderBrush="{StaticResource CiaDividerBrush}"
                                                                    BorderThickness="0,0,1,1"
                                                                    ToolTip="{Binding SourceContext}">
                                                                <TextBlock Margin="8,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource CiaTextPrimaryBrush}"
                                                                           Text="{Binding DisplayValue}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>
                    <StackPanel Margin="0,30,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasReviewRows}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource CiaEmptyStateTitleTextStyle}"
                                   Text="{Binding EmptyStateTitle}" />
                        <TextBlock Margin="0,5,0,0"
                                   MaxWidth="560"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource CiaSecondaryTextStyle}"
                                   Text="{Binding EmptyStateDetail}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="DatabaseLowerRegion" Grid.Row="2" MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="LowerTabs" Height="34" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ExportFieldsTabButton"
                        Click="OnExportFieldsTabClick"
                        Content="Export Fields"
                        Style="{StaticResource CiaButtonStyle}" />
                <Button x:Name="ExcelExportTabButton"
                        Grid.Column="1"
                        Click="OnExcelExportTabClick"
                        Content="Excel Export"
                        Style="{StaticResource CiaButtonStyle}" />
            </Grid>

            <Grid x:Name="LowerPanelGrid" Grid.Row="1" MinHeight="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ExportFieldsColumn" Width="*" />
                    <ColumnDefinition x:Name="LowerPanelGapColumn" Width="8" />
                    <ColumnDefinition x:Name="ExcelExportColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ExportFieldsPanel"
                        Grid.Column="0"
                        ClipToBounds="True"
                        Style="{StaticResource CiaPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Padding="8,6" Style="{StaticResource CiaPanelHeaderStyle}">
                            <Grid>
                                <TextBlock Style="{StaticResource CiaPanelTitleTextStyle}"
                                           Text="EXPORT COLUMN CONFIGURATION" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="{Binding ExportFieldCountText}" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" MinHeight="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="27" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="7,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Style="{StaticResource CiaSourceHeaderTextStyle}" Text="Position" />
                                <TextBlock Grid.Column="2" Style="{StaticResource CiaSourceHeaderTextStyle}" Text="Database Field" />
                                <TextBlock Grid.Column="3" Style="{StaticResource CiaSourceHeaderTextStyle}" Text="Excel Header (Override)" />
                                <TextBlock Grid.Column="4" Style="{StaticResource CiaSourceHeaderTextStyle}" Text="Export" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ExportColumnRows" ItemsSource="{Binding Columns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="34" Margin="7,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="52" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{StaticResource CiaTextMutedBrush}"
                                                           Text="⋮⋮" />
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Position}" />
                                                <TextBlock Grid.Column="2"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DatabaseField}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBox Grid.Column="3"
                                                         Margin="0,4,8,4"
                                                         AutomationProperties.Name="Excel Header Override"
                                                         Style="{StaticResource DatabaseExcelHeaderInputStyle}"
                                                         Text="{Binding ExcelHeader, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                <CheckBox Grid.Column="4"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          AutomationProperties.Name="Export Database column"
                                                          IsChecked="{Binding IsExported}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <Border Grid.Row="2"
                                Padding="8,6"
                                BorderBrush="{StaticResource CiaDividerBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource CiaSecondaryTextStyle}"
                                           Text="Every exportable field can also be made visible through Columns." />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Margin="0,0,4,0"
                                            Command="{Binding ResetHeadersCommand}"
                                            Content="Reset headers"
                                            Style="{StaticResource CiaGhostButtonStyle}" />
                                    <Button Command="{Binding ResetExportCommand}"
                                            Content="Reset export"
                                            Style="{StaticResource CiaGhostButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="ExcelExportPanel"
                        Grid.Column="2"
                        ClipToBounds="True"
                        Style="{StaticResource CiaPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="8,6" Style="{StaticResource CiaPanelHeaderStyle}">
                            <TextBlock Style="{StaticResource CiaPanelTitleTextStyle}"
                                       Text="EXCEL EXPORT" />
                        </Border>
                        <Border Grid.Row="1"
                                Padding="9,7"
                                BorderBrush="{StaticResource CiaDividerBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   Style="{StaticResource DatabaseSectionTextStyle}"
                                                   Text="EXTRACTION RESULT" />
                                        <Border Margin="8,0,0,0"
                                                Style="{StaticResource ExtractionStateBadgeStyle}">
                                            <TextBlock x:Name="ExtractionReviewStateText"
                                                       VerticalAlignment="Center"
                                                       FontSize="10.7"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource CiaTextSecondaryBrush}"
                                                       Text="{Binding ExtractionReviewStateText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource CiaSecondaryTextStyle}"
                                               Text="{Binding ExtractionReviewContext}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ExtractionReviewContext}" />
                                </StackPanel>
                                <Button x:Name="PrepareForExportButton"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Prepare current Database for export"
                                        Command="{Binding PrepareForExportCommand}"
                                        Content="Prepare for export"
                                        Style="{StaticResource CiaButtonStyle}" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="ExcelSettingsGrid" Margin="9,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ExcelLocalColumn" Width="*" />
                                    <ColumnDefinition x:Name="ExcelSettingsGapColumn" Width="12" />
                                    <ColumnDefinition x:Name="ExcelInfoColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="ExcelTopRow" Height="Auto" />
                                    <RowDefinition x:Name="ExcelStackGapRow" Height="0" />
                                    <RowDefinition x:Name="ExcelBottomRow" Height="0" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="ExcelLocalSettings" Grid.Column="0">
                                    <TextBlock Style="{StaticResource DatabaseSectionTextStyle}" Text="LOCAL SETTINGS" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CiaSecondaryTextStyle}" Text="Output folder" />
                                        <TextBox Grid.Column="1" Style="{StaticResource CiaTextInputStyle}" Text="{Binding OutputFolder, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Margin="5,0,0,0" IsEnabled="False" Style="{StaticResource CiaButtonStyle}" Content="Browse" />
                                    </Grid>
                                    <CheckBox Margin="0,7,0,0"
                                              Content="Always ask where to export"
                                              IsChecked="{Binding AlwaysAskWhereToExport}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CiaSecondaryTextStyle}" Text="Filename" />
                                        <TextBox Grid.Column="1" Style="{StaticResource CiaTextInputStyle}" Text="{Binding ExportFileName, Mode=TwoWay}" />
                                    </Grid>
                                    <CheckBox Margin="0,7,0,0"
                                              Content="Auto-fit Columns"
                                              IsChecked="{Binding AutoFitColumns}" />
                                    <CheckBox Margin="0,5,0,0"
                                              Content="Freeze Header Row"
                                              IsChecked="{Binding FreezeHeaderRow}" />
                                </StackPanel>
                                <StackPanel x:Name="ExcelInfo" Grid.Column="2">
                                    <TextBlock Style="{StaticResource DatabaseSectionTextStyle}" Text="INFO" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,5,7">
                                            <TextBlock Style="{StaticResource CiaSecondaryTextStyle}" Text="Workbook" />
                                            <TextBlock FontWeight="Bold" Text="Excel Workbook (.xlsx)" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,7">
                                            <TextBlock Style="{StaticResource CiaSecondaryTextStyle}" Text="Worksheet" />
                                            <TextBlock FontWeight="Bold" Text="Results" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,0,5,0">
                                            <TextBlock Style="{StaticResource CiaSecondaryTextStyle}" Text="Headers" />
                                            <TextBlock FontWeight="Bold" Text="Current names / overrides" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,0,0">
                                            <TextBlock Style="{StaticResource CiaSecondaryTextStyle}" Text="Export fields" />
                                            <TextBlock FontWeight="Bold" Text="{Binding WorkbookExportFieldCountText}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
