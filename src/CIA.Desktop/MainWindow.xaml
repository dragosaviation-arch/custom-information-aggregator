<Window x:Class="CIA.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:CIA.Desktop.Presentation"
        xmlns:views="clr-namespace:CIA.Desktop.Views"
        x:Name="WindowRoot"
        Title="CIA"
        Width="1440"
        Height="900"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CiaBackgroundBrush}"
        FontFamily="{StaticResource CiaFontFamily}"
        FontSize="{StaticResource CiaBodyFontSize}"
        SnapsToDevicePixels="True">
    <Grid Background="{StaticResource CiaBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CiaTopBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="28"
                            Height="28"
                            Background="{StaticResource CiaLogoBrush}"
                            CornerRadius="8">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource CiaPanelBrush}"
                                   Text="C" />
                    </Border>
                    <StackPanel Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock FontWeight="Bold"
                                   Foreground="{StaticResource CiaTextPrimaryBrush}"
                                   Text="CIA" />
                        <TextBlock Margin="0,1,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource CiaTextSecondaryBrush}"
                                   Text="Custom Information Aggregator" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,0,8,0"
                             Fill="{StaticResource CiaSuccessBrush}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource CiaSecondaryTextStyle}"
                               Text="Session active" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CiaNavigationBarStyle}">
            <ListBox AutomationProperties.Name="Principal workspaces"
                     ItemContainerStyle="{StaticResource CiaWorkspaceTabItemStyle}"
                     ItemTemplate="{StaticResource CiaWorkspaceTabTemplate}"
                     ItemsSource="{Binding Workspaces}"
                     SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}"
                     Style="{StaticResource CiaWorkspaceTabsStyle}" />
        </Border>

        <Grid Grid.Row="2">
            <views:LoadWorkspaceView DataContext="{Binding LoadWorkspace, ElementName=WindowRoot}">
                <views:LoadWorkspaceView.Style>
                    <Style TargetType="views:LoadWorkspaceView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.SelectedWorkspace.Area, ElementName=WindowRoot}"
                                         Value="{x:Static presentation:WorkspaceArea.Load}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:LoadWorkspaceView.Style>
            </views:LoadWorkspaceView>

            <Grid Margin="{StaticResource CiaWorkspaceMargin}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedWorkspace.Area}"
                                         Value="{x:Static presentation:WorkspaceArea.Load}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CiaWorkspacePlaceholderTitleTextStyle}"
                               Text="{Binding SelectedWorkspace.Title}" />
                    <TextBlock Margin="0,5,0,0"
                               MaxWidth="700"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource CiaTextSecondaryBrush}"
                               Text="{Binding SelectedWorkspace.Description}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Style="{StaticResource CiaStatusBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,7,0"
                               Style="{StaticResource CiaStatusLabelTextStyle}"
                               Text="Host" />
                    <TextBlock AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="Processing Host status"
                               VerticalAlignment="Center"
                               Style="{StaticResource CiaSecondaryTextStyle}"
                               Text="{Binding GlobalStatus.HostStatusText, ElementName=WindowRoot}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,7,0"
                               Style="{StaticResource CiaStatusLabelTextStyle}"
                               Text="Operation" />
                    <TextBlock AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="Global operation status"
                               VerticalAlignment="Center"
                               Style="{StaticResource CiaSecondaryTextStyle}"
                               Text="{Binding GlobalStatus.OperationStatusText, ElementName=WindowRoot}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
