<Window x:Class="CIA.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="WindowRoot"
        Title="CIA"
        Width="1180"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FFF5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="28,20"
                Background="#FF17263C">
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="CIA" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FFD2DCE9"
                           Text="Custom Information Aggregator" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="18,24"
                    Background="White"
                    BorderBrush="#FFDCE3EC"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="10,0,10,14"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FF52647A"
                               Text="WORKSPACES" />

                    <ListBox AutomationProperties.Name="Principal workspaces"
                             ItemsSource="{Binding Workspaces}"
                             SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="12,11" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFE6EEF8" />
                                        <Setter Property="Foreground" Value="#FF17365F" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1"
                  Margin="40,36">
                <StackPanel>
                    <TextBlock FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="#FF17263C"
                               Text="{Binding SelectedWorkspace.Title}" />
                    <TextBlock Margin="0,12,0,0"
                               MaxWidth="700"
                               HorizontalAlignment="Left"
                               FontSize="16"
                               Foreground="#FF52647A"
                               Text="{Binding SelectedWorkspace.Description}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="28,12"
                Background="#FFEEF2F7"
                BorderBrush="#FFDCE3EC"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#FF52647A"
                               Text="PROCESSING HOST" />
                    <TextBlock AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="Processing Host status"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FF17263C"
                               Text="{Binding GlobalStatus.HostStatusText, ElementName=WindowRoot}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#FF52647A"
                               Text="OPERATION" />
                    <TextBlock AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="Global operation status"
                               FontSize="13"
                               Foreground="#FF17263C"
                               Text="{Binding GlobalStatus.OperationStatusText, ElementName=WindowRoot}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
